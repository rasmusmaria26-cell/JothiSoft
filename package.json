{
  "name": "jothisoft-monorepo",
  "private": true,
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "npx rimraf apps/web/.next apps/web/.turbo .turbo node_modules/.cache"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
