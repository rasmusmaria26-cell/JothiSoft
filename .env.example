# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Node.js Backend API & Security ───────────────────────
PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=https://jothisoft.com,https://www.jothisoft.com

# ── Razorpay ─────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-here

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Prokerala API ─────────────────────────────────────────
PROKERALA_CLIENT_ID=your-client-id-here
PROKERALA_CLIENT_SECRET=your-client-secret-here
PROKERALA_BASE_URL=https://api.prokerala.com/v2
PROKERALA_TOKEN_URL=https://api.prokerala.com/token
PROKERALA_ENV=test
